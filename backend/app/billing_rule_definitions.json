  "temporal_rules": [
    {
      "rule_id": "time.notfall.initial.v1",
      "name": "Notfall-Erstkontakt",
      "gops": ["01210", "01212"],
      "required_context": ["service_date", "service_time"],
      "valid_from": "2025/Q1",
      "regions": ["*"],
      "outcomes": [
        {
          "rule_id": "time.notfall.initial.01212.v1",
          "gop": "01212",
          "when": {"any": [{"special_day": true}, {"time_window": {"start": "07:00", "end": "19:00", "inside": false}}]},
          "note": "Notfallpauschale II: Wochenende/Feiertag/Sondertag oder außerhalb 07:00-19:00 Uhr."
        },
        {
          "rule_id": "time.notfall.initial.01210.v1",
          "gop": "01210",
          "when": {"all": [{"special_day": false}, {"time_window": {"start": "07:00", "end": "19:00", "inside": true}}]},
          "note": "Notfallpauschale I: Werktag von 07:00 Uhr bis vor 19:00 Uhr."
        }
      ]
    },
    {
      "rule_id": "time.notfall.consultation.v1",
      "name": "Notfall-Konsultation",
      "gops": ["01214", "01216", "01218"],
      "required_context": ["service_date", "service_time"],
      "valid_from": "2025/Q1",
      "regions": ["*"],
      "outcomes": [
        {
          "rule_id": "time.notfall.consultation.01216.special.v1",
          "gop": "01216",
          "when": {"all": [{"special_day": true}, {"time_window": {"start": "07:00", "end": "19:00", "inside": true}}]},
          "note": "Konsultation im Notfall: Wochenende/Feiertag/Sondertag von 07:00 Uhr bis vor 19:00 Uhr."
        },
        {
          "rule_id": "time.notfall.consultation.01218.special.v1",
          "gop": "01218",
          "when": {"all": [{"special_day": true}, {"time_window": {"start": "07:00", "end": "19:00", "inside": false}}]},
          "note": "Konsultation im Notfall: Wochenende/Feiertag/Sondertag außerhalb 07:00-19:00 Uhr."
        },
        {
          "rule_id": "time.notfall.consultation.01216.evening.v1",
          "gop": "01216",
          "when": {"all": [{"special_day": false}, {"time_window": {"start": "19:00", "end": "22:00", "inside": true}}]},
          "note": "Konsultation im Notfall: Werktag von 19:00 Uhr bis vor 22:00 Uhr."
        },
        {
          "rule_id": "time.notfall.consultation.01218.night.v1",
          "gop": "01218",
          "when": {"all": [{"special_day": false}, {"time_window": {"start": "07:00", "end": "22:00", "inside": false}}]},
          "note": "Konsultation im Notfall: Werktag von 22:00 Uhr bis vor 07:00 Uhr."
        },
        {
          "rule_id": "time.notfall.consultation.01214.v1",
          "gop": "01214",
          "when": {"all": [{"special_day": false}, {"time_window": {"start": "07:00", "end": "19:00", "inside": true}}]},
          "note": "Konsultation im Notfall: Werktag von 07:00 Uhr bis vor 19:00 Uhr."
        }
      ]
    },
    {
      "rule_id": "time.notfall.clarification.v1",
      "name": "Notfall-Abklärung",
      "gops": ["01205", "01207"],
      "required_context": ["service_date", "service_time"],
      "valid_from": "2025/Q1",
      "regions": ["*"],
      "outcomes": [
        {
          "rule_id": "time.notfall.clarification.01207.v1",
          "gop": "01207",
          "when": {"any": [{"special_day": true}, {"time_window": {"start": "07:00", "end": "19:00", "inside": false}}]},
          "note": "Notfallabklärung: Wochenende/Feiertag/Sondertag oder außerhalb 07:00-19:00 Uhr."
        },
        {
          "rule_id": "time.notfall.clarification.01205.v1",
          "gop": "01205",
          "when": {"all": [{"special_day": false}, {"time_window": {"start": "07:00", "end": "19:00", "inside": true}}]},
          "note": "Notfallabklärung: Werktag von 07:00 Uhr bis vor 19:00 Uhr."
        }
      ]
    }
  ],
  "derived_rules": [
    {
      "rule_id": "derived.notfall.01226.v1",
      "gop": "01226",
      "title_hint": "Zuschlag Notfallpauschale zur GOP 01212",
      "evidence_kind": "derived.notfall.severity",
      "insert_after": "01212",
      "valid_from": "2025/Q1",
      "regions": ["*"],
      "description": "Schweregradzuschlag bei 01212 und dokumentierter komplexer Beeinträchtigung beziehungsweise altersbezogenem Versorgungsbedarf.",
      "requirements": [
        {"gop_present": "01212"}
      ],
      "criteria": [
        {
          "label": "gesicherte Demenz-/Alzheimer-/Parkinson-Diagnose",
          "when": {"icd_prefix_any": ["F00", "F01", "F02", "F03", "G30", "G20.1", "G20.2"]}
        },
        {
          "label": "krankheitsbedingt komplexe kognitive, emotionale oder verhaltensbezogene Beeinträchtigung",
          "when": {"text_any": ["Demenz", "dement", "Alzheimer", "kognitiv", "desorientiert", "orientierungslos", "Delir", "hirnorganisch", "Weglauftendenz", "verhaltens", "Kommunikationsfähigkeit"]}
        },
        {
          "label": "Neugeborenen-/Säuglings-/Kleinkind-Kontext",
          "when": {"any": [{"age": {"max": 5}}, {"text_any": ["Neugeboren", "Säugling", "Kleinkind"]}]}
        },
        {
          "label": "geriatrischer Versorgungsbedarf/Frailty-Kontext ab dem 70. Lebensjahr",
          "when": {"all": [{"age": {"min": 70}}, {"text_any": ["geriatr", "Frailty", "gebrech", "Ganggeschwindigkeit", "Erschöpfung", "muskuläre Schwäche", "verminderte körperliche Aktivität", "Gewichtsverlust", "kognitiv", "desorientiert"]}]}
        }
      ],
      "exclusions": [
        {
          "label": "Kognitive oder verhaltensbezogene Beeinträchtigung ist nur substanzbezogen dokumentiert",
          "action": "review",
          "when": {
            "all": [
              {"text_any": ["Intoxikation", "Alkohol", "Drogen", "psychotrope Substanz", "substanzbedingt"]},
              {"not": {"any": [{"icd_prefix_any": ["F00", "F01", "F02", "F03", "G30", "G20.1", "G20.2"]}, {"text_any": ["Demenz", "Alzheimer"]}]}}
            ]
          }
        }
      ],
      "supporting_evidence": {
        "any": [
          {"evidence_kind": "diagnosis.icd10"},
          {"evidence_kind": "context.kv_notfall_zna"},
          {"text_any": ["Demenz", "dement", "Alzheimer", "kognitiv", "desorientiert", "orientierungslos", "Frailty", "geriatr", "Säugling", "Kleinkind"]}
        ]
      }
    }
  ]
}

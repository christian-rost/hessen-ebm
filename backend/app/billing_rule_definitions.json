  "derived_rules": [
    {
      "rule_id": "derived.notfall.01226.v1",
      "gop": "01226",
      "title_hint": "Zuschlag Notfallpauschale zur GOP 01212",
      "evidence_kind": "derived.notfall.severity",
      "insert_after": "01212",
      "valid_from": "2025/Q1",
      "regions": [
        "*"
      ],
      "description": "Schweregradzuschlag bei 01212 und dokumentierter komplexer Beeinträchtigung beziehungsweise altersbezogenem Versorgungsbedarf.",
      "requirements": [
        {
          "gop_present": "01212"
        }
      ],
      "criteria": [
        {
          "label": "gesicherte Demenz-/Alzheimer-/Parkinson-Diagnose",
          "when": {
            "icd_prefix_any": [
              "F00",
              "F01",
              "F02",
              "F03",
              "G30",
              "G20.1",
              "G20.2"
            ]
          }
        },
        {
          "label": "krankheitsbedingt komplexe kognitive, emotionale oder verhaltensbezogene Beeinträchtigung",
          "when": {
            "text_any": [
              "Demenz",
              "dement",
              "Alzheimer",
              "kognitiv",
              "desorientiert",
              "orientierungslos",
              "Delir",
              "hirnorganisch",
              "Weglauftendenz",
              "verhaltens",
              "Kommunikationsfähigkeit"
            ]
          }
        },
        {
          "label": "Neugeborenen-/Säuglings-/Kleinkind-Kontext",
          "when": {
            "any": [
              {
                "age": {
                  "max": 5
                }
              },
              {
                "text_any": [
                  "Neugeboren",
                  "Säugling",
                  "Kleinkind"
                ]
              }
            ]
          }
        },
        {
          "label": "geriatrischer Versorgungsbedarf/Frailty-Kontext ab dem 70. Lebensjahr",
          "when": {
            "all": [
              {
                "age": {
                  "min": 70
                }
              },
              {
                "text_any": [
                  "geriatr",
                  "Frailty",
                  "gebrech",
                  "Ganggeschwindigkeit",
                  "Erschöpfung",
                  "muskuläre Schwäche",
                  "verminderte körperliche Aktivität",
                  "Gewichtsverlust",
                  "kognitiv",
                  "desorientiert"
                ]
              }
            ]
          }
        }
      ],
      "exclusions": [
        {
          "label": "Kognitive oder verhaltensbezogene Beeinträchtigung ist nur substanzbezogen dokumentiert",
          "action": "review",
          "when": {
            "all": [
              {
                "text_any": [
                  "Intoxikation",
                  "Alkohol",
                  "Drogen",
                  "psychotrope Substanz",
                  "substanzbedingt"
                ]
              },
              {
                "not": {
                  "any": [
                    {
                      "icd_prefix_any": [
                        "F00",
                        "F01",
                        "F02",
                        "F03",
                        "G30",
                        "G20.1",
                        "G20.2"
                      ]
                    },
                    {
                      "text_any": [
                        "Demenz",
                        "Alzheimer"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "supporting_evidence": {
        "any": [
          {
            "evidence_kind": "diagnosis.icd10"
          },
          {
            "evidence_kind": "context.kv_notfall_zna"
          },
          {
            "text_any": [
              "Demenz",
              "dement",
              "Alzheimer",
              "kognitiv",
              "desorientiert",
              "orientierungslos",
              "Frailty",
              "geriatr",
              "Säugling",
              "Kleinkind"
            ]
          }
        ]
      }
    }
  ]
